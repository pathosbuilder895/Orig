# Original live pilot configuration (`run.py --demo` / `original/api.py`).
# Copy to .env, fill secrets, and never commit the populated file.

# Deployment and persistence
ORIGINAL_ENV=demo                 # demo | pilot | staging | production
ORIGINAL_DB=profiles.db           # SQLite path
REPO_BACKEND=sqlite               # sqlite | postgres
REPO_SHADOW=0
DATABASE_URL=
DB_POOL_SIZE=10                   # postgres backend only (original/db/postgres_session.py)
DB_MAX_OVERFLOW=20                # postgres backend only
DB_POOL_RECYCLE=3600              # postgres backend only, seconds
DEBUG=0                           # postgres backend only — 1/true echoes SQL to logs
ALLOWED_ORIGINS=                  # required allowlist outside demo
ENABLE_HSTS=0
SECRET_KEY=                       # required and stable outside demo
GUARD_DESTRUCTIVE=0
MAINTENANCE_TOKEN=
LOGIN_THROTTLE_MAX_ATTEMPTS=10
LOGIN_THROTTLE_WINDOW_SEC=300

# Scoring and report-only mechanisms. Defaults preserve the base behavior.
CONTEXT_MANIFEST_ENABLED=0
ADAPTIVE_WEIGHTS_ENABLED=0
GENRE_INVARIANT_WEIGHTS_ENABLED=0 # ⚠ changes scores; not authorized
GENRE_RESOLVER_V2=off             # off | shadow | on; ⚠ on changes scores
AMPLITUDE_SCORING_ENABLED=0       # ⚠ changes scores
BAYESIAN_PRIOR_ENABLED=0          # ⚠ changes cold-start scores
PRIOR_WEIGHT=3.0
COHORT_PRIOR_FALLBACK=0           # ⚠ changes cold-start scores
NULL_MODEL=none                   # none | impostor
LLR_ACTION_MODE=gate              # shadow | gate | trigger | blend; never use blend
LENGTH_ADAPTIVE_WEIGHTS=0         # ⚠ changes scores
TYPICALITY_POOLED_CALIBRATION=0   # ⚠ experimental; live route not wired
TOPIC_VARIANCE_INFLATION=off      # off | shadow | on; ⚠ on changes scores
TOPIC_INFLATE_GAIN=1.0
CHARACTERISTIC_WEIGHTS=off        # off | shadow | on; ⚠ on changes scores
RANK_REMEDIATION=off              # off | shadow | on; ⚠ on changes scoring state

# AI-likelihood and fused experts are report-only when shadowed.
AI_LIKELIHOOD_ENABLED=0
AI_LIKELIHOOD_SHADOW=0
AI_LIKELIHOOD_MODEL_PATH=
FUSED_SCORE_ENABLED=0
FUSED_SCORE_SHADOW=0
FUSED_SCORE_MODEL_PATH=
LONGITUDINAL_DRIFT_ENABLED=0
LONGITUDINAL_MIN_SAMPLES=6
LONGITUDINAL_CHANGEPOINT_MIN_SAMPLES=12
STYLE_AUTHORSHIP_ENABLED=0
STYLE_AUTHORSHIP_MODEL_PATH=

# Backups and external integrations
BACKUP_DIR=
BACKUP_INTERVAL_MINUTES=
BACKUP_KEEP=
BBOOK_API_URL=
BBOOK_EXTERNAL_SECRET=
CANVAS_BASE_URL=
CANVAS_API_TOKEN=

# LTI 1.3. Supply one private-key form and registered platform JSON.
LTI_PLATFORMS=[]
LTI_PRIVATE_KEY=
LTI_PRIVATE_KEY_FILE=
LTI_PRIVATE_KEY_PEM=
LTI_TOOL_URL=https://app.youruniversity.edu

# Optional provisioning/integration variables
ADMIN_EMAIL=
ADMIN_PASSWORD=
SENDGRID_API_KEY=

# Dormant v1 names such as APP_NAME, ENVIRONMENT, API_V1_PREFIX, Redis,
# FIRST_ADMIN_*, and _ALLOWED_ORIGINS_STR are intentionally omitted. They do
# not configure the live pilot surface; see docs/ARCHITECTURE.md.
